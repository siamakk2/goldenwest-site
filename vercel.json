{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ],
  "redirects": [
    {
      "source": "/product/:slug",
      "destination": "/shop?p=:slug",
      "permanent": true
    },
    {
      "source": "/product/:slug/",
      "destination": "/shop?p=:slug",
      "permanent": true
    },
    {
      "source": "/shop/:slug",
      "destination": "/shop?p=:slug",
      "permanent": true
    },
    {
      "source": "/product-category/:path*",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/product-tag/:path*",
      "destination": "/shop",
      "permanent": true
    }
  ]
}